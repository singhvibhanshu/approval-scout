# Copy to .env and fill in for local runs:  set -a; source .env; set +a; go run .
# In GitHub Actions these come from repository Secrets/Variables instead.

# --- What to scan ---
TARGET_REPO=open-telemetry/opentelemetry-collector-contrib
# A GitHub token. Any token raises the rate limit from 60/hr to 5000/hr.
# Use a fine-grained PAT with "read:org" if you want EXPAND_TEAMS to work.
GH_PAT=ghp_xxxxxxxxxxxxxxxxxxxx

# --- Behaviour (optional) ---
INCLUDE_DRAFTS=false
# Resolve GitHub team membership so an approval from a member of an owning team
# (e.g. the umbrella approvers team) also counts. Needs a token with read:org.
EXPAND_TEAMS=false
# Comma-separated owners to ignore. Handy to drop the umbrella team so the report
# focuses on component owners:
# IGNORE_OWNERS=@open-telemetry/collector-contrib-approvers
IGNORE_OWNERS=
SEND_WHEN_EMPTY=false
REPORT_TIMEZONE=Asia/Kolkata
CONCURRENCY=8
# Print the report instead of emailing - great for a first test run.
DRY_RUN=true

# --- Email delivery (required unless DRY_RUN=true) ---
# Gmail example: create an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com,teammate@example.com
